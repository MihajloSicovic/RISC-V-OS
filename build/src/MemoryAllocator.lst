  42:src/MemoryAllocator.cpp **** int MemoryAllocator::mem_free(void* addr) {
  43:src/MemoryAllocator.cpp ****     if (addr == nullptr) return -1; // Error: Address not provided
  44:src/MemoryAllocator.cpp **** 
  45:src/MemoryAllocator.cpp ****     Header *cur, *prev = nullptr;
  46:src/MemoryAllocator.cpp ****     Header* target = (Header*)((char*)addr - sizeof(Header));
  47:src/MemoryAllocator.cpp **** 
  48:src/MemoryAllocator.cpp ****     // Remove from alloc list
  49:src/MemoryAllocator.cpp ****     for (cur = alloc_head; cur != nullptr && target > cur; prev = cur, cur = cur->next);
  50:src/MemoryAllocator.cpp ****     if (cur == nullptr || cur != target) return -2; // Error: Allocated memory block not found
  51:src/MemoryAllocator.cpp **** 
  52:src/MemoryAllocator.cpp ****     if (prev) prev->next = cur->next;
  53:src/MemoryAllocator.cpp ****     else alloc_head = cur->next;
  54:src/MemoryAllocator.cpp **** 
  55:src/MemoryAllocator.cpp ****     // Add to free list
  56:src/MemoryAllocator.cpp ****     if (free_head == nullptr || target < free_head) cur = nullptr;
  57:src/MemoryAllocator.cpp ****     else for (cur = free_head; cur->next != nullptr && target > cur->next; cur = cur->next);
  58:src/MemoryAllocator.cpp **** 
  59:src/MemoryAllocator.cpp ****     if (cur) target->next = cur->next;
  60:src/MemoryAllocator.cpp ****     else target->next = free_head;
  61:src/MemoryAllocator.cpp **** 
  62:src/MemoryAllocator.cpp ****     if (cur) cur->next = target;
  63:src/MemoryAllocator.cpp ****     else free_head = target;
  64:src/MemoryAllocator.cpp **** 
  65:src/MemoryAllocator.cpp ****     tryToJoin(target);
  66:src/MemoryAllocator.cpp ****     tryToJoin(cur);
  67:src/MemoryAllocator.cpp ****     return 0;
  68:src/MemoryAllocator.cpp **** }
